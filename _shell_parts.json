{
    "head_html": "<!DOCTYPE html>\n<html class=\"dark\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Camelot Flows | Digital Architect</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=JetBrains+Mono:wght@400;700&family=Inter:wght@400;700;900&family=Outfit:wght@400;900&display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js\"></script>\n<script>\n    tailwind.config = {\n        theme: {\n            extend: {\n                colors: {\n                    'obsidian': '#020205',\n                    'obsidian-light': '#08080c',\n                    'primary': '#4f46e5',\n                    'primary-glow': '#7c3aed',\n                    'accent': '#00ffff',\n                    'neon-purple': '#bf00ff',\n                    'neon-cyan': '#00f2ff'\n                },\n                fontFamily: {\n                    'display': ['Orbitron', 'sans-serif'],\n                    'sans': ['Inter', 'sans-serif'],\n                    'mono': ['JetBrains Mono', 'monospace'],\n                    'title': ['Outfit', 'sans-serif'],\n                }\n            }\n        }\n    }\n</script>\n<style>\n    body {\n        background-color: #020205;\n        color: #ffffff;\n        font-family: 'Inter', sans-serif;\n        overflow-x: hidden;\n    }\n    .glass-card {\n        background: rgba(255, 255, 255, 0.03);\n        backdrop-filter: blur(12px);\n        border: 1px solid rgba(255, 255, 255, 0.08);\n        transition: all 0.4s ease;\n    }\n    .glass-panel {\n        background: rgba(10, 10, 18, 0.8);\n        backdrop-filter: blur(24px);\n        border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n    }\n    /* Neon Viewport Frame */\n    body::after {\n        content: '';\n        position: fixed;\n        inset: 0;\n        border: 1px solid rgba(0, 255, 255, 0.2);\n        pointer-events: none;\n        z-index: 9999;\n    }\n    .grid-bg {\n        background-size: 40px 40px;\n        background-image: linear-gradient(to right, rgba(0, 255, 255, 0.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(0, 255, 255, 0.03) 1px, transparent 1px);\n    }\n    .grain-overlay {\n        position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 9999; opacity: 0.05;\n        background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n    }\n    #custom-cursor {\n        position: fixed; top: 0; left: 0; width: 16px; height: 16px; border-radius: 50%;\n        background: #00ffff; box-shadow: 0 0 20px 6px rgba(0, 255, 255, 0.6);\n        pointer-events: none; z-index: 99999; mix-blend-mode: screen; opacity: 0;\n        transform: translate(-50%, -50%);\n    }\n    .text-glow { text-shadow: 0 0 20px rgba(0, 255, 255, 0.5); }\n    .neon-text-cyan { color: #00f2ff; text-shadow: 0 0 8px rgba(0, 242, 255, 0.6); }\n    .neon-text-purple { color: #bf00ff; text-shadow: 0 0 8px rgba(191, 0, 255, 0.6); }\n</style>\n</head>\n<body class=\"bg-obsidian\">\n<div id=\"preloader\" class=\"fixed inset-0 z-[999999] bg-obsidian flex flex-col items-center justify-center font-mono\">\n    <div class=\"w-32 h-[2px] bg-white/10 rounded-full overflow-hidden mb-4\"><div id=\"loader-bar\" class=\"w-0 h-full bg-accent\"></div></div>\n    <div id=\"loader-percent\" class=\"text-accent text-[10px] tracking-widest\">0%</div>\n</div>\n<div class=\"grain-overlay\"></div>\n<div id=\"bg-orbs\" class=\"fixed inset-0 overflow-hidden -z-10 pointer-events-none opacity-20\">\n    <div class=\"bg-orb absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] bg-primary/20 rounded-full blur-[120px]\"></div>\n    <div class=\"bg-orb absolute bottom-[-10%] right-[-10%] w-[40vw] h-[40vw] bg-accent/10 rounded-full blur-[100px]\"></div>\n</div>\n<div id=\"custom-cursor\"></div>\n<div class=\"grid-bg fixed inset-0 opacity-20 pointer-events-none\"></div>\n\n<header class=\"fixed top-0 left-0 w-full z-50 px-6 py-6\">\n    <div class=\"max-w-7xl mx-auto flex items-center justify-between glass-panel rounded-xl px-8 py-4\">\n        <div class=\"flex items-center gap-4 cursor-pointer\" onclick=\"window.location.href='index.html'\">\n            <div class=\"w-10 h-10 rounded-lg bg-indigo-500/20 border border-indigo-500/50 flex items-center justify-center shadow-neon\">\n                <span class=\"material-symbols-outlined text-white text-2xl\">shield_person</span>\n            </div>\n            <div class=\"flex flex-col\">\n                <h1 class=\"text-xl font-display font-black tracking-tighter uppercase text-white leading-none\">Camelot Flows</h1>\n                <span class=\"text-[8px] font-mono text-indigo-400 tracking-[0.3em] uppercase mt-1\">Digital Kingdom // v2.0</span>\n            </div>\n        </div>\n        \n        <nav class=\"hidden lg:flex items-center gap-2\">\n            <a class=\"px-5 py-2 text-[10px] font-mono font-bold text-white/50 hover:text-white uppercase tracking-widest transition-all\" href=\"index.html\">[Home]</a>\n            <a class=\"px-5 py-2 text-[10px] font-mono font-bold text-white/50 hover:text-white uppercase tracking-widest transition-all\" href=\"arsenal.html\">[Arsenal]</a>\n            <a class=\"px-5 py-2 text-[10px] font-mono font-bold text-white/50 hover:text-white uppercase tracking-widest transition-all\" href=\"for-businesses.html\">[Businesses]</a>\n            <a class=\"px-5 py-2 text-[10px] font-mono font-bold text-white/50 hover:text-white uppercase tracking-widest transition-all\" href=\"about.html\">[About]</a>\n            <a class=\"px-5 py-2 text-[10px] font-mono font-bold text-white/50 hover:text-white uppercase tracking-widest transition-all\" href=\"for-agencies.html\">[Agencies]</a>\n            <a class=\"px-5 py-2 text-[10px] font-mono font-bold text-accent uppercase tracking-widest transition-all\" href=\"contact.html\">[Contact]</a>\n        </nav>\n\n        <div class=\"flex items-center gap-6\">\n            <div class=\"hidden sm:flex items-center gap-3 px-4 py-2 rounded-full bg-black/40 border border-white/5\">\n                <div class=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></div>\n                <span class=\"text-[9px] font-mono text-emerald-500 font-bold tracking-widest\">SYS_ONLINE</span>\n            </div>\n            <button onclick=\"window.location.href='contact.html'\" class=\"bg-accent text-black px-8 py-2.5 rounded-lg text-[10px] font-mono font-black tracking-widest hover:scale-105 transition-all shadow-[0_0_20px_rgba(0,255,255,0.3)]\">\n                HIRE ME\n            </button>\n        </div>\n    </div>\n</header>",
    "body_shell": "<div id=\"smooth-wrapper\">\n    <div id=\"smooth-content\">\n        [PAGE_CONTENT]\n        \n        <footer class=\"bg-obsidian-light py-24 px-8 border-t border-white/5 relative\">\n            <div class=\"max-w-7xl mx-auto\">\n                <div class=\"grid grid-cols-1 md:grid-cols-12 gap-16 mb-20\">\n                    <div class=\"md:col-span-4\">\n                        <div class=\"flex items-center gap-4 mb-8\">\n                            <div class=\"w-8 h-8 rounded bg-primary/20 border border-primary/40 flex items-center justify-center\">\n                                <span class=\"material-symbols-outlined text-primary-glow\">shield_person</span>\n                            </div>\n                            <span class=\"font-display text-2xl font-black uppercase tracking-tighter text-white\">Camelot Flows</span>\n                        </div>\n                        <p class=\"text-white/40 text-sm font-mono leading-relaxed\">\n                            <span class=\"text-accent\">&gt;</span> Chisinau, Moldova<br/>\n                            <span class=\"text-accent\">&gt;</span> Tech Stack: Python / AI / GSAP<br/>\n                            <span class=\"text-accent\">&gt;</span> Mission: 100% Performance.\n                        </p>\n                        <div class=\"flex gap-4 mt-8\">\n                            <a href=\"#\" class=\"w-10 h-10 border border-white/10 rounded-lg flex items-center justify-center hover:bg-white/5 transition-all text-white/50\"><span class=\"material-symbols-outlined text-sm\">mail</span></a>\n                            <a href=\"#\" class=\"w-10 h-10 border border-white/10 rounded-lg flex items-center justify-center hover:bg-white/5 transition-all text-white/50\"><span class=\"material-symbols-outlined text-sm\">alternate_email</span></a>\n                        </div>\n                    </div>\n                    \n                    <div class=\"md:col-span-2\">\n                        <h5 class=\"font-mono font-black text-xs text-white/50 uppercase tracking-widest mb-8\">Protocol</h5>\n                        <ul class=\"space-y-4 text-white/40 text-[11px] font-mono uppercase tracking-widest\">\n                            <li><a href=\"arsenal.html\" class=\"hover:text-accent transition-all\">Arsenal</a></li>\n                            <li><a href=\"for-businesses.html\" class=\"hover:text-accent transition-all\">Businesses</a></li>\n                            <li><a href=\"case-studies.html\" class=\"hover:text-accent transition-all\">Case Studies</a></li>\n                            <li><a href=\"for-agencies.html\" class=\"hover:text-accent transition-all\">Agencies</a></li>\n                        </ul>\n                    </div>\n                    \n                    <div class=\"md:col-span-2\">\n                        <h5 class=\"font-mono font-black text-xs text-white/50 uppercase tracking-widest mb-8\">Company</h5>\n                        <ul class=\"space-y-4 text-white/40 text-[11px] font-mono uppercase tracking-widest\">\n                            <li><a href=\"about.html\" class=\"hover:text-accent transition-all\">About</a></li>\n                            <li><a href=\"work-with-me.html\" class=\"hover:text-accent transition-all\">Work With Me</a></li>\n                            <li><a href=\"legal.html\" class=\"hover:text-accent transition-all\">Legal</a></li>\n                        </ul>\n                    </div>\n\n                    <div class=\"md:col-span-4\">\n                        <h5 class=\"font-mono font-black text-xs text-white/50 uppercase tracking-widest mb-8\">Vanguard</h5>\n                        <p class=\"text-white/40 text-xs mb-6 font-mono font-bold uppercase tracking-widest\">Join the digital elite.</p>\n                        <div class=\"relative flex p-1 bg-white/5 border border-white/10 rounded-lg\">\n                            <input type=\"email\" placeholder=\"EMAIL_ADDR\" class=\"bg-transparent border-none text-xs font-mono px-4 flex-1 focus:ring-0 text-white\"/>\n                            <button class=\"bg-accent text-black px-4 py-2 rounded text-[10px] font-black uppercase\">[RUN]</button>\n                        </div>\n                    </div>\n                </div>\n                \n                <div class=\"pt-12 border-t border-white/5 flex justify-between items-center\">\n                    <p class=\"text-[9px] text-white/20 font-mono font-bold tracking-[.3em] uppercase\">© 2026 Camelot Flows. All Rights Reserved.</p>\n                    <div class=\"flex gap-8 text-[9px] text-white/30 font-mono tracking-widest\">\n                        <span class=\"flex items-center gap-2\"><div class=\"w-1 h-1 rounded-full bg-emerald-500\"></div> SYS: OPTIMAL</span>\n                        <span class=\"flex items-center gap-2\"><div class=\"w-1 h-1 rounded-full bg-accent\"></div> REPLAY: ON</span>\n                    </div>\n                </div>\n            </div>\n        </footer>\n    </div>\n</div>\n\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n    document.addEventListener('DOMContentLoaded', () => {\n        // Preloader\n        const preloaderTl = gsap.timeline();\n        preloaderTl.to(\"#loader-percent\", { innerHTML: \"100%\", duration: 1.5, snap: { innerHTML: 1 }, ease: \"power2.inOut\" })\n                 .to(\"#loader-bar\", { width: \"100%\", duration: 1.5, ease: \"power2.inOut\" }, \"<\")\n                 .to(\"#preloader\", { yPercent: -100, duration: 1, ease: \"power4.inOut\", delay: 0.3 });\n\n        // Cursor\n        const cursor = document.getElementById(\"custom-cursor\");\n        window.addEventListener(\"mousemove\", (e) => {\n            gsap.to(cursor, { x: e.clientX, y: e.clientY, opacity: 1, duration: 0.2 });\n        });\n\n        // Entrance Animations\n        gsap.from(\"[data-gsap='fade-up']\", {\n            y: 50, opacity: 0, duration: 1, stagger: 0.1, ease: 'power2.out', scrollTrigger: { trigger: \"body\", start: \"top 90%\" }\n        });\n\n        // Parallax Items\n        document.querySelectorAll(\"[data-gsap='parallax']\").forEach(el => {\n            gsap.to(el, {\n                y: -100, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true }\n            });\n        });\n\n        // Magnetic Buttons\n        document.querySelectorAll(\"button\").forEach(btn => {\n            btn.addEventListener(\"mousemove\", (e) => {\n                const rect = btn.getBoundingClientRect();\n                const x = e.clientX - rect.left - rect.width / 2;\n                const y = e.clientY - rect.top - rect.height / 2;\n                gsap.to(btn, { x: x * 0.3, y: y * 0.3, duration: 0.4 });\n            });\n            btn.addEventListener(\"mouseleave\", () => {\n                gsap.to(btn, { x: 0, y: 0, duration: 0.8, ease: \"elastic.out(1, 0.3)\" });\n            });\n        });\n    });\n</script>\n</body>\n</html>",
    "subpage_js": ""
}
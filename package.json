{
  "name": "camelot-flows",
  "version": "1.2.0",
  "private": true,
  "description": "Camelot Flows static site + WordPress theme",
  "scripts": {
    "build:css": "tailwindcss -i src/tw.css -o assets/css/tailwind.built.css --minify",
    "watch:css": "tailwindcss -i src/tw.css -o assets/css/tailwind.built.css --watch",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.4"
  }
}
